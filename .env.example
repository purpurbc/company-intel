DATABASE_URL=postgresql://app:app@localhost:5432/companyintel
APP_ENV=development
# Comma-separated browser origins. Required explicitly in staging/production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Per API process. Keep the combined maximum below the database connection cap.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
# Overview payloads are regenerated after this many seconds.
OVERVIEW_CACHE_TTL_SECONDS=3600

API_BASE_URL=http://127.0.0.1:8000

SCB_BASE_URL=https://privateapi.scb.se/nv0101/v1/sokpavar/
SCB_TIMEOUT_S=30
SCB_API_ID=
SCB_API_KEY=
SCB_CERT_FILEPATH=
SCB_CERT_PASSWORD=

EMBEDDINGS_MODEL=gemini-embedding-2
GEMINI_DEV_API_KEY=
